generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SSHRemote {
  id String @id @default(cuid())

  name        String
  description String?

  host     String
  port     Int    @default(22)
  username String

  authType SSHAuthType

  password   String?
  privateKey String?
  passphrase String?

  provider String? // vast-ai, runpod, local

  isActive Boolean @default(false)

  pricePerHour   Float?
  currency       String    @default("USD")
  usageStartedAt DateTime?
  usageEndedAt   DateTime?
  connectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SSHAuthType {
  PASSWORD
  PRIVATE_KEY
}
