generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SSHRemote {
  id String @id @default(cuid())

  name        String
  description String?

  host     String
  port     Int    @default(22)
  username String

  authType SSHAuthType

  password   String?
  privateKey String?
  passphrase String?

  provider String? // vast-ai, runpod, lambda-labs, tensordock, azure, aws, local
  machineType String? // Selected VM type/size for display, billing, and provider metadata

  // Provider-specific identifiers
  instanceId     String? // Instance ID from provider (Vast AI job ID, RunPod Pod ID, etc)
  providerApiKey String? // API key for provider (encrypted in production)

  isActive Boolean @default(false)

  pricePerHour   Float?
  currency       String    @default("USD")
  usageStartedAt DateTime?
  usageEndedAt   DateTime?
  connectedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  autoStops AutoStop[]
}

enum SSHAuthType {
  PASSWORD
  PRIVATE_KEY
}

model AutoStop {
  id String @id @default(cuid())

  sshRemoteId String?
  sshRemote   SSHRemote? @relation(fields: [sshRemoteId], references: [id], onDelete: Cascade)

  targetType  AutoStopTargetType @default(SSH_REMOTE)
  scheduledAt DateTime
  status      AutoStopStatus     @default(PENDING)
  executedAt  DateTime?
  error       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([sshRemoteId, status])
}

enum AutoStopTargetType {
  SSH_REMOTE
  ALL_ACTIVE
}

enum AutoStopStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELED
  FAILED
}
